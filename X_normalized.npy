   "cell_type": "markdown",
   "id": "cf3f928c-2e84-4e0b-af0c-66312158bd68",
   "metadata": {},
   "source": [
    "### PART A: REPRODUCIBLE NORMALIZATION PROBLEM"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "23489c44-f8cd-44ce-bbf7-29fa44b78f4e",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "cb1ba464-7e19-47f0-8592-309cc9a56ea9",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Array X:\n",
      " [[48 11 15 67 21]\n",
      " [11 41 13 66 24]\n",
      " [71 79 53 67 70]\n",
      " [77 35 91 19 96]\n",
      " [35 54 37 41 17]]\n",
      "\n",
      "Normalized Array (X_normalized):\n",
      " [[ 0.06340841 -1.36714726 -1.2124926   0.79801809 -0.98051059]\n",
      " [-1.36714726 -0.20723725 -1.28981993  0.75935442 -0.86451959]\n",
      " [ 0.95267275  1.26198209  0.25672675  0.79801809  0.91400909]\n",
      " [ 1.18465476 -0.43921926  1.72594609 -1.05783793  1.91926443]\n",
      " [-0.43921926  0.29539042 -0.36189192 -0.20723725 -1.13516526]]\n",
      "\n",
      "Mean of X_normalized: 0.0\n",
      "Standard Deviation of X_normalized: 0.9999999999999999\n"
     ]
    }
   ],
   "source": [
    "np.random.seed(2112)\n",
    "\n",
    "X = np.random.randint(10, 101, size=(5, 5))\n",
    "\n",
    "x_bar = X.mean()\n",
    "sigma = X.std()\n",
    "\n",
    "X_normalized = (X - x_bar) / sigma\n",
    "\n",
    "print(\"Array X:\\n\", X)\n",
    "print(\"\\nNormalized Array (X_normalized):\\n\", X_normalized)\n",
    "print(\"\\nMean of X_normalized:\", X_normalized.mean())\n",
    "print(\"Standard Deviation of X_normalized:\", X_normalized.std())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "43fe9964-ba6f-4b83-af37-eb22e0316c0e",
   "metadata": {},
   "outputs": [],
   "source": []
  },
