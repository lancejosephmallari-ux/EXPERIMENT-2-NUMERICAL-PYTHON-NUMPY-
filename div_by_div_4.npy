   "id": "1aab7356-f0f9-4b1d-a9c4-0acbcb51d6fa",
   "metadata": {},
   "source": [
    "# B. CUBES DIVISIBLE BY 4 PROBLEM"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "99fd8fd4-c4bb-4a45-9c9b-b25071dc61fe",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "c8bccdac-d8f4-4082-b4cc-877f8d9e2ce0",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Shape of C: (10, 10)\n",
      "\n",
      "Array of cubed values divisible by 4 (div_by_4):\n",
      " [      8      64     216     512    1000    1728    2744    4096    5832\n",
      "    8000   10648   13824   17576   21952   27000   32768   39304   46656\n",
      "   54872   64000   74088   85184   97336  110592  125000  140608  157464\n",
      "  175616  195112  216000  238328  262144  287496  314432  343000  373248\n",
      "  405224  438976  474552  512000  551368  592704  636056  681472  729000\n",
      "  778688  830584  884736  941192 1000000]\n",
      "\n",
      "Number of selected elements: 50\n",
      "First element: 8\n",
      "Last element: 1000000\n"
     ]
    }
   ],
   "source": [
    "C = (np.arange(1, 101) ** 3).reshape(10, 10)\n",
    "\n",
    "div_by_4 = C[C % 4 == 0]\n",
    "\n",
    "print(\"Shape of C:\", C.shape)\n",
    "print(\"\\nArray of cubed values divisible by 4 (div_by_4):\\n\", div_by_4)\n",
    "print(\"\\nNumber of selected elements:\", div_by_4.size)\n",
    "print(\"First element:\", div_by_4[0])\n",
    "print(\"Last element:\", div_by_4[-1])\n",
    "\n",
    "np.save (\"div_by_4.npy\", div_by_4)"
   ]
  }
 ],
